# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obter em: https://supabase.com/dashboard → projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Obter em: Supabase → Settings → Database → Connection string (Transaction Pooler)
DATABASE_URL=

# Obter em: Supabase → Settings → Database → Connection string (Session Pooler ou Direct)
DIRECT_URL=

# ─── Anthropic / Claude API ───────────────────────────────────────────────────
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Firecrawl (scraping) ─────────────────────────────────────────────────────
# Obter em: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# ─── Upstash Redis (fila assíncrona) ─────────────────────────────────────────
# Obter em: https://console.upstash.com → banco Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
